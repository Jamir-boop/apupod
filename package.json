{
  "name": "local-podcast-builder",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "node --import tsx --test",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fastify": "5.9.0",
    "fastify-type-provider-zod": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "tsx": "4.22.5",
    "typescript": "6.0.3"
  }
}
