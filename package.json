{
  "name": "apupod",
  "version": "1.4.1",
  "description": "Agent-driven local podcast studio: MCP tools and skills for hosts, plans, scripts, and TTS audio, with a browser UI.",
  "keywords": [
    "podcast",
    "tts",
    "text-to-speech",
    "mcp",
    "model-context-protocol",
    "agent-skills",
    "claude-code",
    "codex",
    "opencode"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jamir-boop/apupod.git"
  },
  "type": "module",
  "bin": {
    "apupod": "bin/apupod.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "skills/",
    ".claude-plugin/",
    ".mcp.json",
    "plugin.json",
    "mcp.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node bin/apupod.mjs serve",
    "start": "node bin/apupod.mjs serve",
    "test": "node --test --test-force-exit test/*.test.mjs",
    "version": "node scripts/sync-version.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
