# apupod reads this file from its config dir: $APUPOD_CONFIG_DIR, else $XDG_CONFIG_HOME/apupod, else ~/.config/apupod.
# Copy it to <config dir>/.env (mode 0600), or set keys in the Settings view. Process environment variables win.

# TTS providers. Set only the ones you use.
MIMO_API_KEY=
# Optional; defaults to https://api.xiaomimimo.com/v1.
MIMO_BASE_URL=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
CHATTERBOX_API_KEY=
# OpenAI-compatible TTS connection keys are generated here by the Settings view, for example:
# OPENAI_COMPAT_LOCAL_PROVIDER_0123456789AB_API_KEY=

# Optional. Enables Jev typed decisions (TypeSafe). apupod works without it.
TYPESAFE_API_KEY=

# Optional. HTTP port on 127.0.0.1 (default 4173).
PORT=
