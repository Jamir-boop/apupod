MIMO_API_KEY=sk-...
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
ELEVENLABS_API_KEY=sk_...
OPENAI_API_KEY=sk-...
# OpenAI Decisions uses this existing billed API key, not ChatGPT OAuth.
# No additional OpenAI Decisions secret is required.
# Optional. Enable Jev configuration decisions in Model Connections.
TYPESAFE_API_KEY=
# ChatGPT plan sign-in uses protected OAuth storage, not an API key.
# Optional auth-storage root: $XDG_CONFIG_HOME/pod-god/chatgpt (default: ~/.config).
# XDG_CONFIG_HOME=
# Optional override; otherwise OpenCode Go reuses the current OpenCode login.
OPENCODE_GO_API_KEY=
CHATTERBOX_API_KEY=
# Compatible connection keys are generated here by Config view, for example:
# OPENAI_COMPAT_LOCAL_PROVIDER_0123456789AB_API_KEY=sk-...
PORT=4173
# Optional; relocates the OpenCode Go login lookup ($XDG_DATA_HOME/opencode/auth.json).
# XDG_DATA_HOME=
